<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">



        <Spinner
            android:id="@+id/tipo"
            android:layout_width="332dp"
            android:layout_height="20dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="192dp"
            android:layout_marginBottom="451dp"
            android:entries="@array/tipo_de_unidad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/identif"
        android:layout_width="206dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="484dp"
        android:ems="10"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="Identificador"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Identificador" />

        <RadioGroup
            android:id="@+id/grupo"
            android:layout_width="215dp"
            android:layout_height="120dp"
            android:layout_marginStart="448dp"
            android:layout_marginTop="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <RadioButton
                android:id="@+id/boton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Armadura de Hierro"
                tools:text="Armadura de Hierro" />

            <RadioButton
                android:id="@+id/boton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escudo de Isengard"
                tools:text="Escudo de Isengard" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/antorcha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="448dp"
            android:layout_marginTop="196dp"
            android:text="Llevar Antorcha de Polvorín"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/enviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="524dp"
            android:layout_marginTop="320dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_send" />



</androidx.constraintlayout.widget.ConstraintLayout>